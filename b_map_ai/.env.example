# ============================================================================
# B Map AI - Production Environment Variables Template
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Persistence (Neon Serverless PostgreSQL - Primary)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<EP_HOST>.aws.neon.tech/b_map_ai?sslmode=require

# Secondary / Document Database (MongoDB - Optional)
# If offline/unreachable, the platform automatically activates high-availability in-memory fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/bmap_ai

# Security & Rate Limiting
BMAP_API_KEY=your_secure_random_api_key_here
JWT_SECRET=your_super_secret_jwt_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Google DeepMind Gemma 3 (1B) Inference Service Configuration
# If hosted on Hugging Face Spaces, use your Space URL (e.g. https://<username>-bmap-gemma-engine.hf.space)
GEMMA_HOST=127.0.0.1
GEMMA_PORT=5005
GEMMA_API_URL=https://<YOUR_HF_USERNAME>-bmap-gemma-engine.hf.space
PYTHON_PATH=e:\v\Scripts\python.exe
GEMMA_DIR=e:\ai_for_bmap\b_map_ai\gemma
AUTO_START_GEMMA=false

# Keep-Alive & Auto-Ping Configuration (Prevents Free Cloud Hosting from Sleeping)
ENABLE_KEEP_ALIVE=true
PING_INTERVAL_MS=60000
# Set PING_URL to your public domain when deployed (e.g. https://your-service.onrender.com/ping)
PING_URL=http://localhost:3000/ping
